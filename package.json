{
  "name": "mediahub-bot",
  "version": "1.0.0",
  "description": "Self-hosted Discord bot for a Plex/Seerr/Lidarr/Aurral/Wizarr media stack: requests, notifications, status board and invites.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "better-sqlite3": "^13.2.0",
    "discord.js": "^14.28.1",
    "express": "^5.3.0",
    "obscenity": "0.4.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
