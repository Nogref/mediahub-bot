# =============================================================================
# MediaHub bot: copy to .env and fill in. Every service block is optional:
# leave a block empty and its commands/status line simply don't appear.
#
# URLs are what the BOT CONTAINER can reach. On a shared Docker network use the
# container name (http://lidarr:8686), never localhost/127.0.0.1 (inside the
# container that is the bot itself). Plex in host-network mode: use the Unraid
# host IP, e.g. http://192.168.1.10:32400.
# =============================================================================

# --- Discord ----------------------------------------------------------------------
# Required. Bot token: Discord Developer Portal → your application → Bot → Reset Token.
DISCORD_TOKEN=
# Required. Your server's ID (Discord: User Settings → Advanced → Developer Mode on,
# then right-click the server icon → Copy Server ID). Commands register here only.
GUILD_ID=

# Admin role: /setup …, /admin …, unlimited /invite, seeing everyone's invites, no redownload limits
# (right-click role → Copy Role ID). If unset, Discord's Administrator permission counts as admin.
ADMIN_ROLE_ID=

# --- Channels (right-click channel → Copy Channel ID) ---------------------------
# Easier: leave these empty and set them from Discord with /setup channels. Values set
# there are stored by the bot and win over these.
# Live status board + "service down/recovered" heads-ups. Unset = no board (/status still works).
STATUS_CHANNEL_ID=
# New-content announcements (off until /setup announcements mode:on). Requests are DMed either way.
NOTIFY_CHANNEL_ID=
# Admin-only notices: *arr health issues, failed downloads, webhook tests, invite audit log.
# Falls back to STATUS_CHANNEL_ID when unset.
ADMIN_CHANNEL_ID=
# Admin-only log of every /redownload: who, what, why, and each step, with Cancel /
# Approve / Ban buttons. Falls back to ADMIN_CHANNEL_ID. Keep it private to admins.
REDOWNLOAD_LOG_CHANNEL_ID=
# Where /suggest posts members' ideas for everyone to 👍. Make it read-only for members
# (the bot posts on their behalf, after a family-friendly check). Also settable with
# /setup channels suggestions:#channel.
SUGGESTIONS_CHANNEL_ID=

# --- Ping roles (/pings) -------------------------------------------------------------------
# The bot creates Movies, TV, Music and Server status roles itself (/setup welcome or
# /setup pings). They only control who gets @-pinged; every feature is open to everyone.
# Only set these to reuse roles you already have (right-click role → Copy Role ID).
ROLE_MOVIES_ID=
ROLE_TV_ID=
ROLE_MUSIC_ID=
ROLE_STATUS_ID=
# Optional separate channel for album announcements. Unset = NOTIFY_CHANNEL_ID.
# Also settable with /setup channels music_announcements:#channel.
MUSIC_NOTIFY_CHANNEL_ID=

# --- Public links shown to members --------------------------------------------------------
# Also settable from Discord with /setup links (stored by the bot, wins over these).
# Where members open Aurral (shown with their login after /aurral).
AURRAL_PUBLIC_URL=
# Your self-hosted Plezy Watch Together relay, shown in the Plezy guide. Empty = Plezy's default.
PLEZY_RELAY_URL=

# --- Self-serve invites --------------------------------------------------------------------
# Members with this role can create Wizarr invites and /invite aurral accounts for others
# (admins always can).
INVITER_ROLE_ID=
# Max active invites per inviter (0 = no cap). Admins are never capped.
INVITER_MAX_ACTIVE=3
# Longest expiry an inviter can choose: 1, 7 or 30 days (Wizarr's options). Their links are always single use.
INVITER_EXPIRY_DAYS=7

# --- Webhook server ---------------------------------------------------------------
# Port the bot listens on for POST /webhook/<service> and GET /healthz.
WEBHOOK_PORT=8787
# Shared secret senders must present as ?secret=..., an X-Webhook-Secret header,
# or "Authorization: Bearer ...". Strongly recommended. Generate: openssl rand -hex 24
WEBHOOK_SECRET=

# --- Seerr: /request movie|series, request stats, status line ----------------------
# Seerr → Settings → General → API Key.
SEERR_URL=http://seerr:5055
SEERR_API_KEY=
# Optional public URL, used only to make result titles clickable links.
SEERR_PUBLIC_URL=
# true = attribute each request to the Seerr user whose profile has the requester's
# Discord ID (Profile → Settings → Notifications → Discord ID). Requests still
# auto-approve either way, because the bot calls Seerr with the admin API key.
SEERR_ATTRIBUTE_USERS=true

# --- Plex: /random movie, /stats, /plex, status line ---------------------------------------
# /plex lets members connect their Plex account; it's how /redownload knows they're
# really on your server (checked against your share list). Needs the owner's token below.
# Plex in host network mode? Use the host IP instead of a container name.
PLEX_URL=http://plex:32400
# How to find it: https://support.plex.tv/articles/204059436
PLEX_TOKEN=
# Optional comma-separated movie library names for /random movie (default: all movie libraries).
PLEX_MOVIE_LIBRARIES=

# --- Tautulli: status line (+ inbound webhooks, see README) -------------------------
# Tautulli → Settings → Web Interface → API → API key.
TAUTULLI_URL=http://tautulli:8181
TAUTULLI_API_KEY=

# --- Lidarr: /request album, /stats, status line ------------------------------------
# Lidarr → Settings → General → Security → API Key.
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=
# Defaults used when the bot has to add a new artist. Each may be left empty to
# use Lidarr's first configured entry.
# Root folder path exactly as shown in Lidarr → Settings → Media Management (e.g. /music).
LIDARR_ROOT_FOLDER=
# Quality profile name or ID (Settings → Profiles).
LIDARR_QUALITY_PROFILE=
# Metadata profile name or ID (Settings → Profiles). Lidarr requires one to add an artist.
LIDARR_METADATA_PROFILE=

# --- Aurral: /request album (fallback or primary), status line ---------------------------
# Admin API key: Aurral → Settings → General → API access.
AURRAL_URL=http://aurral:3001
AURRAL_API_KEY=

# Where /request album goes first: lidarr or aurral. The other one is the fallback
# when the first is unreachable or doesn't have the album.
MUSIC_REQUEST_TARGET=lidarr

# --- Navidrome: status line only ---------------------------------------------------------
# Leave empty if you only use Aurral's built-in Subsonic server.
NAVIDROME_URL=

# --- Music streaming into voice channels (/music) -----------------------------------------
# Any Subsonic server: Aurral's built-in one (same address as AURRAL_URL) or Navidrome.
# Leave empty to use AURRAL_URL. Create a dedicated user for the bot (e.g. "discord") and
# make sure Opus transcoding works; the bot asks for format=opus so it never transcodes itself.
SUBSONIC_URL=
SUBSONIC_USER=
SUBSONIC_PASSWORD=
# Stream bitrate in kbps (Discord voice tops out around 128 on unboosted servers).
MUSIC_BITRATE=128
# Leave the voice channel after this many minutes with nothing playing or nobody listening.
MUSIC_IDLE_MINUTES=5

# --- Wizarr: /invite create|list|revoke, status line -------------------------------------
# Wizarr → Settings → API Keys → Create (the key is shown once).
WIZARR_URL=http://wizarr:5690
WIZARR_API_KEY=
# The address friends open, used to build the invite links the bot hands out
# (e.g. https://join.example.com). Without it, links use WIZARR_URL.
WIZARR_PUBLIC_URL=
# Optional comma-separated Wizarr server IDs to invite to. Default: every verified Plex server in Wizarr.
WIZARR_SERVER_IDS=

# --- Radarr / Sonarr: status lines, /redownload (+ inbound webhooks, see README) ----------
# The API key turns on /redownload for movies (Radarr) and TV (Sonarr), and makes the status
# check validate the key. Without it: status via the unauthenticated /ping only.
# Settings → General → Security → API Key. Redownloads also need each app's Recycling Bin
# set (Settings → Media Management → File Management, show advanced): no bin, no deletes.
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# --- Self-serve redownloads (/redownload) --------------------------------------------------
# Members replace broken files themselves. Admins skip these limits. Pause, ban, approve-first
# and requiring a linked Plex account (/admin redownloads plexcheck) are switched from Discord.
# Per member, per rolling 24 hours. A whole season counts as 2. 0 = admins only.
REDOWNLOAD_DAILY_LIMIT=2
# After a title is replaced, nobody can redo it for this many hours (0 = no cooldown).
REDOWNLOAD_TITLE_COOLDOWN_HOURS=48
# Redownloads running at once, server-wide.
REDOWNLOAD_MAX_ACTIVE=3
# Releases to try before giving up (the first pick + this many - 1 fallbacks).
REDOWNLOAD_MAX_ATTEMPTS=3
# Give up on a single download (and try the next release) after this many hours.
REDOWNLOAD_ATTEMPT_TIMEOUT_HOURS=24

# --- Tuning (defaults are fine) ------------------------------------------------------------
# Notification batch window: events arriving within it become one message per channel.
NOTIFY_BATCH_SECONDS=60
# Don't re-announce the same title (e.g. Radarr then Seerr then Tautulli) within this many hours.
NOTIFY_DEDUPE_HOURS=6
# How often to look for requests made on the Seerr website, to DM their requester a live
# tracker (needs their Discord ID in Seerr). 0 turns that off; /request trackers still work.
REQUEST_RECONCILE_MINUTES=10
# Stop tracking a request after this many days (counted from release day if it wasn't out yet).
REQUEST_TRACK_DAYS=30
# How often the stats board (/setup stats) re-checks the numbers. It only edits when one changes.
STATS_REFRESH_MINUTES=30
# Health-check interval for the status board (minimum 15).
STATUS_INTERVAL_SECONDS=60
# When nothing changed, refresh latencies/timestamp on the board at most this often.
STATUS_REFRESH_MINUTES=5
# Consecutive failed checks before a service counts as down (avoids alerting on a blip).
STATUS_FAIL_THRESHOLD=2
# Responses slower than this (ms) mark a service as slow (yellow board).
STATUS_SLOW_MS=2000
# Timeout for normal API calls (ms). Health checks always use 5000.
HTTP_TIMEOUT_MS=10000
# Where SQLite state lives inside the container. Mount a volume here. The bot also reads
# settings from bot.env in this folder (any variable from this file), so on Unraid you can keep
# them in /mnt/user/appdata/mediahub-bot/bot.env. Container values win when they're set.
DATA_DIR=/data
# debug | info | warn | error
LOG_LEVEL=info

# --- Container (Docker only) ---------------------------------------------------------------
# User/group the bot runs as; /data is chowned to them on start. Unraid default: 99/100.
PUID=99
PGID=100

# --- Reserved ------------------------------------------------------------------------------
# Listed in the original spec alongside "promotion buttons", but no promotion feature
# was specified, so nothing reads it yet. Safe to leave empty.
PROMOTE_SECRET=
